PORT=3001
VITE_REGISTRATION_API_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=safar_registration
DB_USER=safar_app
DB_PASSWORD=replace_with_a_local_secret

# DOKU Checkout: keep in sandbox until production credentials and account are ready.
DOKU_MODE=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Optional comma-separated override for bank VA channels activated on the merchant account.
DOKU_PAYMENT_METHOD_TYPES=
PUBLIC_APP_URL=
PAYMENT_DP_POLICY=
PAYMENT_DP_VALUE=
